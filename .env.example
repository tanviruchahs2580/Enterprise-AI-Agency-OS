# Local API configuration.
# Only these variables are read by the current API.
# Planned services, model providers, and agent tooling are not implemented.
# Never commit real credentials.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=.data/agency.db
LOG_LEVEL=info
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
